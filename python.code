import math

class UltimateCalculator:
    def __init__(self):
        self.memory = None
        self.history = []

    def add(self, a, b): return a + b
    def subtract(self, a, b): return a - b
    def multiply(self, a, b): return a * b
    def divide(self, a, b):
        if b == 0: return "Error: Division by zero"
        return a / b
    def power(self, a, b): return math.pow(a, b)
    def sqrt(self, a): return math.sqrt(a)
    def factorial(self, a): return math.factorial(int(a))
    def sin(self, a): return math.sin(math.radians(a))
    def cos(self, a): return math.cos(math.radians(a))
    def tan(self, a): return math.tan(math.radians(a))

    def convert_temperature(self, value, to_unit):
        if to_unit == "C": return (value - 32) * 5/9
        elif to_unit == "F": return (value * 9/5) + 32
        else: return "Error: Invalid unit"

    def convert_length(self, value, to_unit):
        if to_unit == "m": return value * 0.3048
        elif to_unit == "ft": return value / 0.3048
        else: return "Error: Invalid unit"

    def convert_weight(self, value, to_unit):
        if to_unit == "kg": return value * 0.453592
        elif to_unit == "lb": return value / 0.453592
        else: return "Error: Invalid unit"

    def store(self, value): self.memory = value
    def recall(self): return self.memory
    def clear_memory(self): self.memory = None

    def add_to_history(self, operation, result):
        self.history.append(f"{operation} = {result}")

    def show_history(self):
        return "\n".join(self.history)

# CLI interface
def main():
    calc = UltimateCalculator()
    while True:
        print("\nChoose an operation:")
        print("1. Add\n2. Subtract\n3. Multiply\n4. Divide")
        print("5. Power\n6. Square Root\n7. Factorial")
        print("8. Sin\n9. Cos\n10. Tan")
        print("11. Convert Temperature (F<->C)")
        print("12. Convert Length (ft<->m)")
        print("13. Convert Weight (lb<->kg)")
        print("14. Memory Store\n15. Memory Recall\n16. Clear Memory")
        print("17. Show History\n18. Exit")

        choice = input("Enter choice: ")

        try:
            if choice == "1":
                a, b = float(input("a: ")), float(input("b: "))
                result = calc.add(a, b)
            elif choice == "2":
                a, b = float(input("a: ")), float(input("b: "))
                result = calc.subtract(a, b)
            elif choice == "3":
                a, b = float(input("a: ")), float(input("b: "))
                result = calc.multiply(a, b)
            elif choice == "4":
                a, b = float(input("a: ")), float(input("b: "))
                result = calc.divide(a, b)
            elif choice == "5":
                a, b = float(input("Base: ")), float(input("Exponent: "))
                result = calc.power(a, b)
            elif choice == "6":
                a = float(input("Number: "))
                result = calc.sqrt(a)
            elif choice == "7":
                a = float(input("Number: "))
                result = calc.factorial(a)
            elif choice == "8":
                a = float(input("Angle in degrees: "))
                result = calc.sin(a)
            elif choice == "9":
                a = float(input("Angle in degrees: "))
                result = calc.cos(a)
            elif choice == "10":
                a = float(input("Angle in degrees: "))
                result = calc.tan(a)
            elif choice == "11":
                temp = float(input("Temperature: "))
                unit = input("Convert to (C/F): ").upper()
                result = calc.convert_temperature(temp, unit)
            elif choice == "12":
                length = float(input("Length: "))
                unit = input("Convert to (m/ft): ").lower()
                result = calc.convert_length(length, unit)
            elif choice == "13":
                weight = float(input("Weight: "))
                unit = input("Convert to (kg/lb): ").lower()
                result = calc.convert_weight(weight, unit)
            elif choice == "14":
                val = float(input("Value to store: "))
                calc.store(val)
                result = f"Stored {val}"
            elif choice == "15":
                result = calc.recall()
            elif choice == "16":
                calc.clear_memory()
                result = "Memory cleared"
            elif choice == "17":
                print("\n--- History ---")
                print(calc.show_history())
                continue
            elif choice == "18":
                print("Goodbye!")
                break
            else:
                print("Invalid choice.")
                continue

            print(f"Result: {result}")
            calc.add_to_history(choice, result)

        except Exception as e:
            print("Error:", e)

if __name__ == "__main__":
    main()
